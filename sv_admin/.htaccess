# Админка продаж в папке /sv_admin: одна страница-оболочка, адреса разбирает приложение в браузере.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /sv_admin/
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Robots-Tag "noindex, nofollow"
	# Оболочку не кешируем: после выкладки сразу новая версия.
	# Файлы в _app/immutable/ с хешем в имени кешируем навсегда.
	<Files "index.html">
		Header set Cache-Control "no-cache"
	</Files>
	<If "%{REQUEST_URI} =~ m#^/sv_admin/_app/immutable/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
